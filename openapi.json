{
  "openapi": "3.0.3",
  "info": {
    "title": "Urja Meter Operations API",
    "version": "1.0.0",
    "description": "REST API wrapper for the legacy Urja Meter Operations portal. The wrapper manages portal authentication and exposes meter data."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "API health checks"
    },
    {
      "name": "Meters",
      "description": "Meter metadata and readings"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check API health",
        "responses": {
          "200": {
            "description": "API is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "List or search meters",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search term for meter records"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Page number"
          }
        ],
        "responses": {
          "200": {
            "description": "Meter list with pagination metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters"
          },
          "502": {
            "description": "Upstream service failure"
          }
        }
      }
    },
    "/api/v1/meters/{meterId}": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get meter details, location and consumption",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "J100000"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Combined meter details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetails"
                }
              }
            }
          },
          "404": {
            "description": "Meter not found"
          },
          "502": {
            "description": "Upstream service failure"
          }
        }
      }
    },
    "/api/v1/meters/{meterId}/consumption": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get meter consumption readings",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Energy readings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream service failure"
          }
        }
      }
    },
    "/api/v1/meters/{meterId}/geo": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get meter geographical coordinates",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meter coordinates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeoResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream service failure"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Meter": {
        "type": "object",
        "properties": {
          "meterId": {
            "type": "string",
            "example": "J100000"
          },
          "serialNo": {
            "type": "string",
            "example": "SE33962"
          },
          "make": {
            "type": "string",
            "example": "HPL"
          },
          "phaseType": {
            "type": "string",
            "example": "single"
          },
          "installStatus": {
            "type": "string",
            "example": "Decommissioned"
          },
          "dtCode": {
            "type": "string",
            "example": "DT-001"
          }
        }
      },
      "MeterList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Meter"
            }
          },
          "total": {
            "type": "integer",
            "example": 403
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "example": 20
          }
        }
      },
      "MeterDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Meter"
          },
          {
            "type": "object",
            "properties": {
              "geo": {
                "$ref": "#/components/schemas/GeoCoordinates"
              },
              "energy": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ConsumptionReading"
                }
              }
            }
          }
        ]
      },
      "GeoCoordinates": {
        "type": "object",
        "nullable": true,
        "properties": {
          "latitude": {
            "type": "number",
            "nullable": true,
            "example": 26.938961002479868
          },
          "longitude": {
            "type": "number",
            "nullable": true,
            "example": 75.83095696146852
          }
        }
      },
      "GeoResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/GeoCoordinates"
          }
        }
      },
      "ConsumptionReading": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "nullable": true,
            "example": "23/06/2026 23:30"
          },
          "kwh": {
            "type": "number",
            "nullable": true,
            "example": 48438.74
          },
          "kvah": {
            "type": "number",
            "nullable": true,
            "example": 52313.84
          },
          "voltR": {
            "type": "number",
            "nullable": true,
            "example": 226
          }
        }
      },
      "ConsumptionResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsumptionReading"
            }
          }
        }
      }
    }
  }
}
